{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "nim: build (debug)",
            "type": "shell",
            "command": "nim",
            "args": [
                "c",
                "--debugger:native", // Включить поддержку отладчика
                //"-g", // Генерировать отладочные символы (DWARF)
                "--out:${workspaceFolder}/bin/${fileBasenameNoExtension}", // Путь к выходному файлу
                "${file}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$nim"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "nim: run tests",
            "type": "shell",
            "command": "nim",
            "args": [
                "test",
                "${workspaceFolder}/tests/all.nim"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}