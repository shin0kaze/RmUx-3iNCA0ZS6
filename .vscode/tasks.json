{
  "version": "2.0.0",
  "tasks": [
    //
    // Собрать проект для отладки
    {
      "label": "nim c: build game debug",
      "type": "shell",
      "command": "nim",
      "args": [
        "c",
        "--debugger:native", // Включить поддержку отладчика
        "-g", // Генерировать отладочные символы (DWARF)
        "--out:${workspaceFolder}/bin/${fileBasenameNoExtension}", // Путь к выходному файлу
        "${workspaceFolder}/src/main.nim"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$nim"
      ],
    },
    //
    // Собрать проект для релиза
    {
      "label": "nim c: build game release",
      "type": "shell",
      "command": "nim",
      "args": [
        "c",
        "-d:release",
        "-d:strip",
        "--out:${workspaceFolder}/bin/${fileBasenameNoExtension}",
        "${workspaceFolder}/src/main.nim"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$nim"
      ],
    },
    //
    // Собрать открытый файл
    {
      "label": "nim c: build file debug",
      "type": "shell",
      "command": "nim",
      "args": [
        "c",
        "--debugger:native", // Включить поддержку отладчика
        "--out:${workspaceFolder}/bin/${fileBasenameNoExtension}", // Путь к выходному файлу
        "${file}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$nim"
      ],
    },
    //
    // Запустить все тесты
    {
      "label": "nim: run tests",
      "type": "shell",
      "command": "testament",
      "args": [
        "all",
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
    },
    //
    // Запустить тесты для файла
    //
    // Запустить тесты для файла с отчетом
    //
    // Очистка папки /bin
    {
      "label": "clean-logs-native",
      "type": "shell",
      "windows": {
        "command": "powershell",
        "args": [
          "-Command",
          "Remove-Item -Path './bin' -Recurse -Force -ErrorAction SilentlyContinue"
        ]
      },
      "linux": {
        "command": "rm",
        "args": [
          "-rf",
          "./bin/logs"
        ]
      }
    },
  ]
}